# Fill this on the Proxmox node, then run: sudo ./deploy.sh ./config.env
CTID=250
PVE_STORAGE=local-lvm
TEMPLATE_STORAGE=local
BRIDGE=vmbr0
IP_CONFIG=dhcp
# GATEWAY=192.168.1.1  # required only for a static IP_CONFIG
GATEWAY=
VLAN_TAG=
CORES=4
MEMORY_MB=8192
ROOTFS_GB=64
SSH_PUBLIC_KEY_FILE=/root/.ssh/id_ed25519.pub
